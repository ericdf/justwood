{
  "name": "justwood-design",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npx @11ty/eleventy --serve\" \"postcss src/assets/css/main.css -o _site/assets/css/main.css --watch\"",
    "build": "postcss src/assets/css/main.css -o _site/assets/css/main.css && npx @11ty/eleventy",
    "build:css": "postcss src/assets/css/main.css -o _site/assets/css/main.css",
    "build:eleventy": "npx @11ty/eleventy"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.0",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.0"
  }
}
