    {# Tool card: Carver's Pattern Maker #}
    <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-start mb-16">
      {# App icon — squircle is baked into the PNG, so no CSS radius here #}
      <a href="{{ '/pattern_maker/' | url }}" target="_blank" rel="noopener" class="shrink-0">
        <img src="{{ '/assets/images/tools/pattern-maker-icon.png' | url }}"
