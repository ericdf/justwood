{#
  category-nav.njk
  Set `activeCat` in page frontmatter to highlight the current category and use page URLs.
  Leave `activeCat` unset on the home page to use section anchors (buttons, no hash hrefs).
#}
<nav id="category-nav" class="sticky z-40 bg-ground border-b border-ash" style="top: 52px;">
  <div class="overflow-x-auto">
    <div class="flex items-center gap-0 px-8 whitespace-nowrap font-ui text-[11px] tracking-widest uppercase">
      {% set cats = [
        { id: "furniture", name: "Furniture", url: "/furniture/" },
        { id: "lighting",  name: "Lighting",  url: "/lighting/" },
        { id: "panels",    name: "Panels",    url: "/panels/" },
        { id: "bowls",     name: "Bowls",     url: "/bowls/" },
        { id: "objects",   name: "Objects",   url: "/objects/" }
      ] %}
      {% for cat in cats %}
        {% if loop.index > 1 %}
          <span class="text-charcoal/30 px-3 select-none">·</span>
        {% endif %}
        {% if not activeCat %}
          {# Button: no href, no hash navigation — avoids Safari's deferred anchor scroll bug #}
          <button type="button" data-scroll="{{ cat.id }}"
                  class="py-4 text-charcoal hover:text-cedar transition-colors bg-transparent border-0 cursor-pointer font-ui text-[11px] tracking-widest uppercase">{{ cat.name }}</button>
        {% else %}
          <a href="{{ cat.url | url }}"
             class="py-4 transition-colors {% if activeCat == cat.id %}text-charcoal font-medium{% else %}text-charcoal hover:text-cedar{% endif %}">{{ cat.name }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</nav>

{% if not activeCat %}
<script>
  (function () {
    var nav = document.getElementById('category-nav');
    if (!nav) return;

    nav.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-scroll]');
      if (!btn) return;
      var target = document.getElementById(btn.getAttribute('data-scroll'));
      if (!target) return;
      var headerH = (document.querySelector('header') || {}).offsetHeight || 52;
      var offset = headerH + nav.offsetHeight + 8;
      var y = window.scrollY + target.getBoundingClientRect().top - offset;
      window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
    });
  })();
</script>
{% endif %}
