---
layout: base.njk
title: Objects
permalink: /objects/
activeCat: objects
needsJapanese: true
---

<div class="px-8 pt-16 pb-10 border-b border-ash">
  <h1 class="font-display text-5xl md:text-6xl font-light text-charcoal mb-4">Objects</h1>
  <p class="font-body text-lg text-charcoal/70 max-w-2xl">Architectural studies, ritual objects, and pieces that resist easy category — each made with the same attention as the furniture.</p>
</div>

{% include "category-nav.njk" %}

<div class="grid grid-cols-2 gap-[4px] mt-[4px]">
  {% for piece in pieces %}
    {% if piece.category == "objects" %}
    <div class="group overflow-hidden">
      <a href="{{ ('/work/' + piece.slug + '/') | url }}" class="block" style="height: max(280px, 35vw);">
        {% image piece.primaryImage, piece.title, "(min-width: 768px) 50vw, 100vw", "lazy", "w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">
          {{ piece.title }}
          {% if piece.titleJapanese %}<span class="text-ash" style="font-family: 'Noto Serif JP', serif;">{{ piece.titleJapanese }}</span>{% endif %}
        </h3>
      </div>
    </div>
    {% endif %}
  {% endfor %}
</div>
