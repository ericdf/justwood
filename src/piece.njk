---
pagination:
  data: pieces
  size: 1
  alias: piece
permalink: /work/{{ piece.slug }}/
layout: base.njk
eleventyComputed:
  title: "{{ piece.title }}"
  excerpt: "{{ piece.excerpt }}"
  primaryImage: "{{ piece.primaryImage }}"
  ogTitle: "{% if piece.shortTitle %}{{ piece.shortTitle }}{% else %}{{ piece.title }}{% endif %} — {{ site.title }}"
---

{# Hero — portrait: solid warm bg, contained; standard: full-width cover #}
{% if piece.orientation == 'portrait' %}
<section class="piece-hero relative w-full h-[75vh] flex items-center justify-center bg-paper">
  {% image piece.primaryImage, piece.title, "100vw", "eager", "max-h-full w-auto object-contain" %}
  <div class="scroll-hint-wrap" style="color: var(--color-ash);"
       onclick="document.querySelector('.piece-content').scrollIntoView({behavior:'smooth'})">
    <div class="scroll-hint">{% include "scroll-chevron.njk" %}</div>
  </div>
</section>
{% else %}
<section class="piece-hero relative w-full h-[75vh] overflow-hidden">
  {% image piece.primaryImage, piece.title, "100vw", "eager", "w-full h-full object-cover object-center" %}
  <div class="scroll-hint-wrap" style="color: rgba(255,255,255,0.9);"
       onclick="document.querySelector('.piece-content').scrollIntoView({behavior:'smooth'})">
    <div class="scroll-hint">{% include "scroll-chevron.njk" %}</div>
  </div>
</section>
{% endif %}

{# Title + description + sidebar — constrained width #}
<div class="piece-content max-w-7xl mx-auto px-8 py-16">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-16">

    <div class="md:col-span-2">
      <h1 class="font-display text-4xl md:text-5xl font-light text-charcoal leading-tight mb-1">
        {{ piece.title }}
        {% if piece.titleJapanese %}
          <span style="font-family: serif;" class="font-light text-charcoal/60">{{ piece.titleJapanese }}</span>
        {% endif %}
      </h1>
      <p class="font-ui text-sm tracking-widest uppercase text-charcoal/70 mb-8 border-b border-ash pb-6">{{ piece.category }}</p>

      <div class="font-body text-lg text-charcoal leading-relaxed space-y-6">
        {% for para in piece.description.split("\n\n") %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
    </div>

    <aside class="font-ui">
      <div class="border-t border-ash pt-6 space-y-5">
        {% if piece.materials %}
        <div>
          <p class="text-[11px] tracking-widest uppercase text-charcoal/70 mb-1">Materials</p>
          <p class="text-sm text-charcoal leading-snug">{{ piece.materials }}</p>
        </div>
        {% endif %}
        {% if piece.dimensions %}
        <div>
          <p class="text-[11px] tracking-widest uppercase text-charcoal/70 mb-1">Dimensions</p>
          <p class="text-sm text-charcoal">{{ piece.dimensions }}</p>
        </div>
        {% endif %}
        {% if piece.wiring %}
        <div>
          <p class="text-[11px] tracking-widest uppercase text-charcoal/70 mb-1">Wiring</p>
          <p class="text-sm text-charcoal">{{ piece.wiring }}</p>
        </div>
        {% endif %}
        <div class="pt-5 border-t border-ash">
          <p class="text-[11px] tracking-widest uppercase text-charcoal/70 mb-3">Interested?</p>
          <a href="{{ '/commission/' | url }}"
             class="block text-center border border-charcoal text-charcoal text-sm py-3 px-4 hover:bg-charcoal hover:text-ground transition-colors uppercase tracking-widest">
            Commission this piece
          </a>
        </div>
      </div>
    </aside>

  </div>
</div>

{# Image strip + lightbox — always present; hero (uncropped) is index 0, secondary images follow #}
<div
  x-data='{
    open: false,
    current: 0,
    images: ["{{ piece.primaryImage | url }}"{% if piece.images and piece.images.length %}{% for img in piece.images %},"{{ img | url }}"{% endfor %}{% endif %}],
    prev() { this.current = (this.current - 1 + this.images.length) % this.images.length },
    next() { this.current = (this.current + 1) % this.images.length }
  }'
>
  {# Desktop: scrollable image strip — shows ~3 cells, arrows + swipe to navigate #}
  <div class="hidden md:block relative" style="height: 500px;">
    {# Left arrow #}
    <button
      @click="$refs.stripTrack.scrollBy({ left: -$refs.stripTrack.offsetWidth / 3, behavior: 'smooth' })"
      class="absolute left-0 top-0 bottom-0 z-10 px-4 flex items-center bg-gradient-to-r from-ground/70 to-transparent text-charcoal/60 hover:text-charcoal transition-colors focus:outline-none"
      aria-label="Previous photos"
      style="font-size: 2.5rem; line-height: 1;"
    >‹</button>
    {# Right arrow #}
    <button
      @click="$refs.stripTrack.scrollBy({ left: $refs.stripTrack.offsetWidth / 3, behavior: 'smooth' })"
      class="absolute right-0 top-0 bottom-0 z-10 px-4 flex items-center bg-gradient-to-l from-ground/70 to-transparent text-charcoal/60 hover:text-charcoal transition-colors focus:outline-none"
      aria-label="Next photos"
      style="font-size: 2.5rem; line-height: 1;"
    >›</button>
    {# Scrollable track #}
    <div
      x-ref="stripTrack"
      class="strip-track flex h-full overflow-x-auto gap-[10px]"
      style="scroll-snap-type: x mandatory;"
    >
      <button @click="open = true; current = 0" class="relative flex-none overflow-hidden focus:outline-none group" style="width: 33.333%; height: 500px; scroll-snap-align: start;">
        {% image piece.primaryImage, piece.title, "33vw", "lazy", "absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" %}
      </button>
      {% for img in piece.images %}
      {% set imgPos = (piece.imagesObjectPosition and piece.imagesObjectPosition[loop.index0]) or "center" %}
      <button @click="open = true; current = {{ loop.index0 + 1 }}" class="relative flex-none overflow-hidden focus:outline-none group" style="width: 33.333%; height: 500px; scroll-snap-align: start;">
        {% image img, piece.title + " — detail " + loop.index, "33vw", "lazy", "absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]", "object-position: " + imgPos %}
      </button>
      {% endfor %}
    </div>
  </div>

  {# Mobile: single-column stack #}
  <div class="md:hidden flex flex-col gap-1">
    <button @click="open = true; current = 0" class="w-full focus:outline-none">
      {% image piece.primaryImage, piece.title, "100vw", "lazy", "w-full h-auto" %}
    </button>
    {% for img in piece.images %}
    <button @click="open = true; current = {{ loop.index0 + 1 }}" class="w-full focus:outline-none">
      {% image img, piece.title + " — detail " + loop.index, "100vw", "lazy", "w-full h-auto" %}
    </button>
    {% endfor %}
  </div>

  {# Lightbox #}
  <div
    x-show="open"
    x-transition:enter="transition duration-200"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition duration-150"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="open = false"
    @keydown.escape.window="open = false"
    @keydown.arrow-left.window="if (open) prev()"
    @keydown.arrow-right.window="if (open) next()"
    class="fixed inset-0 flex items-center justify-center bg-blackwood/95"
    style="display: none; z-index: 10000;"
  >
    <button
      @click.stop="open = false"
      class="absolute top-6 right-6 font-ui text-sm tracking-widest uppercase text-ground/70 hover:text-ground"
    >✕ Close</button>

    <button
      @click.stop="prev()"
      class="absolute left-4 md:left-10 text-ground/60 hover:text-ground font-light leading-none"
      style="font-size: 3rem;"
    >‹</button>
    <button
      @click.stop="next()"
      class="absolute right-4 md:right-10 text-ground/60 hover:text-ground font-light leading-none"
      style="font-size: 3rem;"
    >›</button>

    <template x-for="(img, i) in images" :key="i">
      <img
        x-show="current === i"
        :src="img"
        :alt="'{{ piece.title }} — ' + (i === 0 ? 'hero' : 'detail ' + i)"
        class="max-h-[90vh] max-w-[90vw] object-contain"
        @click.stop
      >
    </template>

    <p class="absolute bottom-6 font-ui text-sm tracking-widest text-ground/50">
      <span x-text="current + 1"></span> / <span x-text="images.length"></span>
    </p>
  </div>

</div>

{# Fade chevron when hero scrolls out of view #}
<script>
  (function () {
    var hero = document.querySelector('.piece-hero');
    var hint = document.querySelector('.scroll-hint-wrap');
    if (!hero || !hint) return;
    new IntersectionObserver(function (entries) {
      hint.classList.toggle('hero-gone', !entries[0].isIntersecting);
    }, { threshold: 0.05 }).observe(hero);
  })();
</script>

{# Related pieces #}
{% set related = pieces | byCategory(piece.category) %}
{% set currentSlug = piece.slug %}
{% if related.length > 1 %}
<div class="max-w-7xl mx-auto px-8 pb-20 mt-20 border-t border-ash pt-12">
  <h2 class="font-display text-2xl font-light text-charcoal mb-8">More {{ piece.category }}</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {% for rel in related %}
      {% if rel.slug != currentSlug %}
      <article class="group">
        <a href="{{ ('/work/' + rel.slug + '/') | url }}" class="block">
          <div class="overflow-hidden bg-paper flex items-center justify-center {% if rel.relatedCardOrientation == 'portrait' %}aspect-[3/4]{% else %}aspect-[4/3]{% endif %}">
            {% image rel.primaryImage, rel.title, "(min-width: 1280px) 400px, (min-width: 768px) 33vw, 100vw", "lazy", "w-full h-full object-contain transition-transform duration-700 group-hover:scale-[1.03]" %}
          </div>
          <div class="mt-2 px-1">
            <p class="font-ui text-[11px] tracking-widest uppercase text-charcoal/80 mb-1">{{ rel.category }}</p>
            <h3 class="font-display font-light leading-snug text-charcoal
                       {% if rel.featured %}text-2xl md:text-3xl{% else %}text-xl md:text-2xl{% endif %}">
              {{ rel.title }}
              {% if rel.titleJapanese %}
                <span class="text-charcoal/70" style="font-family: serif;">{{ rel.titleJapanese }}</span>
              {% endif %}
            </h3>
          </div>
        </a>
      </article>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": {{ piece.title | dump | safe }},
  "description": {{ piece.excerpt | dump | safe }},
  "image": {{ (site.url + piece.primaryImage) | dump | safe }},
  "creator": {
    "@type": "Person",
    "name": {{ site.author | dump | safe }}
  }{% if piece.materials %},
  "material": {{ piece.materials | dump | safe }}{% endif %}{% if piece.date %},
  "dateCreated": {{ piece.date | dump | safe }}{% endif %}
}
</script>
