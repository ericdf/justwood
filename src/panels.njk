---
layout: base.njk
title: Panels
permalink: /panels/
activeCat: panels
needsJapanese: true
---

<div class="px-8 pt-16 pb-10 border-b border-ash">
  <h1 class="font-display text-5xl md:text-6xl font-light text-charcoal mb-4">Panels</h1>
  <p class="font-body text-lg text-charcoal/70 max-w-2xl">Wall panels in the kumiko and shoji tradition — geometric, meditative, and made to hold light.</p>
</div>

{% include "category-nav.njk" %}

<div class="grid grid-cols-2 gap-[4px] mt-[4px] items-start">
  {% for piece in pieces %}
    {% if piece.category == "panels" %}
    <div class="group overflow-hidden">
      <a href="{{ ('/work/' + piece.slug + '/') | url }}" class="block">
        {% image piece.primaryImage, piece.title, "(min-width: 768px) 50vw, 100vw", "lazy", "w-full h-auto transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">
          {{ piece.title }}
          {% if piece.titleJapanese %}<span class="text-ash" style="font-family: 'Noto Serif JP', serif;">{{ piece.titleJapanese }}</span>{% endif %}
        </h3>
      </div>
    </div>
    {% endif %}
  {% endfor %}
</div>
