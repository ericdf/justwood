---
layout: base.njk
title: false
preloadImage: "assets/images/credenza/featured.jpeg"
primaryImage: /assets/images/credenza/featured.jpeg
ogTitle: "Just Wood: Made by hand. Built to last."
---

{# Hero — credenza #}
<section class="relative w-full h-[75vh] overflow-hidden">
  {% image "assets/images/credenza/featured.jpeg", "Cherry and quilted maple credenza", "100vw", "eager", "w-full h-full object-cover object-[center_50%]" %}
  <div class="absolute inset-0 bg-gradient-to-t from-blackwood/60 via-blackwood/10 to-transparent"></div>
  <div class="absolute bottom-10 left-8 md:left-16">
    <p class="font-display text-ground text-4xl md:text-6xl font-light leading-tight">
      Made by hand.<br>Built to last.
    </p>
    <p class="font-ui text-charcoal/80 text-xs tracking-widest uppercase mt-3">Berkeley, California</p>
  </div>
</section>

{# Sticky category nav #}
{% include "category-nav.njk" %}

{# Editorial sections #}

{# ── FURNITURE ─────────────────────────────────────────────────────── #}
{% set bed   = pieces | getBySlug("heirloom-bed") %}
{% set table = pieces | getBySlug("parquet-table") %}

<section class="border-t border-ash mt-10 md:mt-16">
  <div class="px-8 py-5">
    <h2 id="furniture" class="font-ui text-[11px] tracking-widest uppercase text-charcoal">Furniture</h2>
  </div>
  <div class="grid grid-cols-2 gap-[4px]">

    <div class="col-span-2 group overflow-hidden">
      <a href="{{ '/work/heirloom-bed/' | url }}" class="block overflow-hidden"
         style="height: max(280px, 40vw);">
        {% image bed.primaryImage, bed.title, "100vw", "lazy", "w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]", "object-position: center 20%" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-2xl font-light text-charcoal">{{ bed.title }}</h3>
      </div>
    </div>

    <div class="col-span-2 group overflow-hidden">
      <a href="{{ '/work/parquet-table/' | url }}" class="block" style="height: max(280px, 40vw);">
        {% image table.primaryImage, table.title, "100vw", "eager", "w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-2xl font-light text-charcoal">{{ table.title }}</h3>
      </div>
    </div>

    <div class="col-span-2">
      <a href="{{ '/furniture/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Furniture →
      </a>
    </div>

  </div>
</section>

{# ── LIGHTING ──────────────────────────────────────────────────────── #}
{% set igeta    = pieces | getBySlug("igeta-lantern") %}
{% set waterdrop = pieces | getBySlug("water-drop-lantern") %}

<section class="border-t border-ash mt-10 md:mt-16">
  <div class="px-8 py-5">
    <h2 id="lighting" class="font-ui text-[11px] tracking-widest uppercase text-charcoal">Lighting</h2>
  </div>
  <div class="grid grid-cols-2 gap-[4px]">

    <div class="group">
      <a href="{{ '/work/igeta-lantern/' | url }}" class="flex items-center justify-center"
         style="background-color: var(--color-paper); height: max(280px, 49vw);">
        {% image igeta.primaryImage, igeta.title, "50vw", "lazy", "max-h-full w-auto object-contain transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">
          {{ igeta.title }}
          {% if igeta.titleJapanese %}<span class="text-ash" style="font-family: serif;">{{ igeta.titleJapanese }}</span>{% endif %}
        </h3>
      </div>
    </div>

    <div class="group">
      <a href="{{ '/work/water-drop-lantern/' | url }}" class="flex items-center justify-center"
         style="background-color: var(--color-paper); height: max(280px, 49vw);">
        {% image waterdrop.primaryImage, waterdrop.title, "50vw", "lazy", "max-h-full w-auto object-contain transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">{{ waterdrop.title }}</h3>
      </div>
    </div>

    <div class="col-span-2">
      <a href="{{ '/lighting/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Lighting →
      </a>
    </div>

  </div>
</section>

{# ── PANELS ────────────────────────────────────────────────────────── #}
{% set kurotake = pieces | getBySlug("kurotake-panel") %}
{% set sakura   = pieces | getBySlug("kumiko-panel") %}

<section class="border-t border-ash mt-10 md:mt-16">
  <div class="px-8 py-5">
    <h2 id="panels" class="font-ui text-[11px] tracking-widest uppercase text-charcoal">Panels</h2>
  </div>
  {# Natural proportions, vertically centered — no forced height #}
  <div class="grid grid-cols-2 gap-[4px] items-center">

    <div class="group overflow-hidden">
      <a href="{{ '/work/kurotake-panel/' | url }}" class="block">
        {% image kurotake.primaryImage, kurotake.title, "50vw", "lazy", "w-full h-auto transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">
          {{ kurotake.title }}
          {% if kurotake.titleJapanese %}<span class="text-ash" style="font-family: serif;">{{ kurotake.titleJapanese }}</span>{% endif %}
        </h3>
      </div>
    </div>

    <div class="group overflow-hidden">
      <a href="{{ '/work/kumiko-panel/' | url }}" class="block">
        {% image sakura.primaryImage, sakura.title, "50vw", "lazy", "w-full h-auto transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">
          {{ sakura.title }}
          {% if sakura.titleJapanese %}<span class="text-ash" style="font-family: serif;">{{ sakura.titleJapanese }}</span>{% endif %}
        </h3>
      </div>
    </div>

    <div class="col-span-2">
      <a href="{{ '/panels/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Panels →
      </a>
    </div>

  </div>
</section>

{# ── BOWLS ─────────────────────────────────────────────────────────── #}
<section class="border-t border-ash mt-10 md:mt-16">
  <div class="px-8 py-5">
    <h2 id="bowls" class="font-ui text-[11px] tracking-widest uppercase text-charcoal">Bowls</h2>
  </div>
  <div class="grid grid-cols-2 gap-[4px]">

    {# 2 Segmented — split, no title labels #}
    {% for card in bowls.cards %}
      {% if card.subcategory == "segmented" %}
      <div class="group overflow-hidden">
        <a href="{{ '/bowls/segmented/' | url }}" class="block bg-paper" style="height: max(280px, 35vw);">
          {% image card.image, "Segmented bowl", "50vw", "lazy", "w-full h-full " + ("object-contain" if card.fit == "contain" else "object-cover") + " transition-transform duration-700 group-hover:scale-[1.02]" %}
        </a>
      </div>
      {% endif %}
    {% endfor %}

    <div class="col-span-2">
      <a href="{{ '/bowls/segmented/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Segmented Bowls →
      </a>
    </div>

    {# 2 Found Wood — split, no title labels #}
    {% for card in bowls.cards %}
      {% if card.subcategory == "found" %}
      <div class="group overflow-hidden">
        <a href="{{ '/bowls/found/' | url }}" class="block bg-paper" style="height: max(280px, 35vw);">
          {% image card.image, "Found wood bowl", "50vw", "lazy", "w-full h-full " + ("object-contain" if card.fit == "contain" else "object-cover") + " transition-transform duration-700 group-hover:scale-[1.02]" %}
        </a>
      </div>
      {% endif %}
    {% endfor %}

    <div class="col-span-2">
      <a href="{{ '/bowls/found/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Found Wood Bowls →
      </a>
    </div>

    {# 1 Carved — span, no title label #}
    {% for card in bowls.cards %}
      {% if card.subcategory == "carved" %}
      <div class="col-span-2 group overflow-hidden">
        <a href="{{ '/bowls/carved/' | url }}" class="flex items-center justify-center bg-paper p-6"
           style="height: max(280px, 40vw);">
          {% image card.image, "Hand carved bowl", "100vw", "lazy", "max-h-full max-w-full object-contain transition-transform duration-700 group-hover:scale-[1.02]" %}
        </a>
      </div>
      {% endif %}
    {% endfor %}

    <div class="col-span-2">
      <a href="{{ '/bowls/carved/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Carved Bowls →
      </a>
    </div>

  </div>
</section>

{# ── OBJECTS ───────────────────────────────────────────────────────── #}
{% set tokyo    = pieces | getBySlug("tokyo-bracket") %}
{% set hanukk   = pieces | getBySlug("hanukkiah") %}

<section class="border-t border-ash mt-10 md:mt-16">
  <div class="px-8 py-5">
    <h2 id="objects" class="font-ui text-[11px] tracking-widest uppercase text-charcoal">Objects</h2>
  </div>
  <div class="grid grid-cols-2 gap-[4px]">

    <div class="group overflow-hidden">
      <a href="{{ '/work/tokyo-bracket/' | url }}" class="flex items-center justify-center bg-paper"
         style="height: max(280px, 35vw);">
        {% image tokyo.primaryImage, tokyo.title, "50vw", "lazy", "max-h-full max-w-full object-contain transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">
          {{ tokyo.title }}
          {% if tokyo.titleJapanese %}<span class="text-ash" style="font-family: serif;">{{ tokyo.titleJapanese }}</span>{% endif %}
        </h3>
      </div>
    </div>

    <div class="group overflow-hidden">
      <a href="{{ '/work/hanukkiah/' | url }}" class="block" style="height: max(280px, 35vw);">
        {% image hanukk.primaryImage, hanukk.title, "50vw", "lazy", "w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" %}
      </a>
      <div class="mt-2 px-3 pb-5">
        <h3 class="font-display text-xl font-light text-charcoal">{{ hanukk.title }}</h3>
      </div>
    </div>

    <div class="col-span-2">
      <a href="{{ '/objects/' | url }}" class="block text-center border border-charcoal text-charcoal font-ui text-sm tracking-widest uppercase py-4 hover:bg-charcoal hover:text-ground transition-colors">
        See all Objects →
      </a>
    </div>

  </div>
</section>

{# Commission CTA #}
<section class="bg-blackwood py-20 px-6 text-center mt-10 md:mt-16">
  <p class="font-display text-ground text-3xl md:text-5xl font-light mb-4">
    Every piece is made to order.
  </p>
  <p class="font-body text-ash max-w-lg mx-auto mb-10 leading-relaxed">
    Commission a piece built for your space, your wood, your life.
  </p>
  <a href="{{ '/commission/' | url }}"
     class="font-ui text-xs tracking-widest uppercase text-ground border border-ash px-8 py-3 hover:bg-ground hover:text-blackwood transition-colors">
    Begin a Conversation
  </a>
</section>
